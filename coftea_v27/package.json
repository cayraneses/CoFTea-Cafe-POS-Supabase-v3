{
  "name": "coftea-cafe-pos",
  "version": "3.0.0",
  "description": "CoF/Tea Café POS with Supabase cloud sync, realtime monitoring, Windows installer and mobile PWA",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build:win": "electron-builder --win",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:build": "cd android && gradlew.bat assembleDebug",
    "android:assets": "npx capacitor-assets generate --android --iconBackgroundColor \"#f7efe4\" --iconBackgroundColorDark \"#f7efe4\" --splashBackgroundColor \"#f7efe4\" --splashBackgroundColorDark \"#f7efe4\"",
    "android:refresh": "npm run android:assets && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/core": "^8.5.1",
    "@supabase/supabase-js": "^2.116.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.1",
    "electron": "^37.2.6",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.coftea.offlinepos",
    "productName": "CoFTea Offline POS",
    "files": [
      "**/*",
      "!node_modules/.cache/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "coftea.ico"
    },
    "icon": "coftea.ico",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "CoF/Tea Café POS",
      "installerIcon": "coftea.ico",
      "uninstallerIcon": "coftea.ico",
      "deleteAppDataOnUninstall": false
    }
  }
}